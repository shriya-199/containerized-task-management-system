{
  "info": {
    "name": "Containerized Task Management System",
    "description": "Postman collection for API, Auth, and Worker service verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "apiBaseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "authBaseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "workerBaseUrl",
      "value": "http://localhost:3002"
    },
    {
      "key": "taskId",
      "value": "1"
    },
    {
      "key": "jwtToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Checks",
      "item": [
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/health",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Auth Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authBaseUrl}}/health",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Worker Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{workerBaseUrl}}/health",
              "host": [
                "{{workerBaseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/register",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "register"
              ]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.token) {",
                  "  pm.collectionVariables.set('jwtToken', response.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Task API Service",
      "item": [
        {
          "name": "Get All Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/tasks",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            }
          }
        },
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.id) {",
                  "  pm.collectionVariables.set('taskId', response.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Docker deployment\",\n  \"description\": \"Verify containers, logs, health checks, and database connectivity.\",\n  \"status\": \"pending\"\n}"
            },
            "url": {
              "raw": "{{apiBaseUrl}}/tasks",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            }
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Docker deployment\",\n  \"description\": \"Verified Docker Compose stack successfully.\",\n  \"status\": \"in_progress\"\n}"
            },
            "url": {
              "raw": "{{apiBaseUrl}}/tasks/{{taskId}}",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/tasks/{{taskId}}",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
